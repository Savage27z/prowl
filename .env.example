# Base Chain RPC
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org

# Basescan (Etherscan V2) API Key
BASESCAN_API_KEY=

# OpenRouter API Key (for AI reasoning)
OPENROUTER_API_KEY=your_openrouter_api_key

# Sibyl Memory Mode: "local" | "bridge"
SIBYL_MODE=local

# Sibyl Bridge URL (only if SIBYL_MODE=bridge)
SIBYL_BRIDGE_URL=http://localhost:5001

# Upstash Redis (persistent memory — survives cold starts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bounty Contract Address (Base mainnet)
BOUNTY_CONTRACT_ADDRESS=0x...

# Deployer Private Key (for contract deployment only)
DEPLOYER_PRIVATE_KEY=your_private_key

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Iron-session secret (min 32 chars — used to encrypt auth cookies)
SESSION_SECRET=change-this-to-a-random-32-char-string

# Optional: operator-verified known addresses, merged over the built-in table.
# A wrong `terminal: true` ends an investigation at the wrong wallet, so verify
# each address on basescan before adding it. terminal defaults to false.
# KNOWN_ADDRESSES_EXTRA={"0x...":{"label":"Coinbase deposit","category":"cex","terminal":true}}
